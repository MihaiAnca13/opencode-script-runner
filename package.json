{
  "name": "opencode-script-runner",
  "version": "1.0.0",
  "description": "Run shell scripts in the background from OpenCode and get notified when they finish.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/MihaiAnca13/opencode-script-runner.git"
  },
  "bugs": {
    "url": "https://github.com/MihaiAnca13/opencode-script-runner/issues"
  },
  "homepage": "https://github.com/MihaiAnca13/opencode-script-runner",
  "keywords": [
    "opencode",
    "plugin",
    "opencode-v2",
    "background",
    "script",
    "process",
    "runner"
  ],
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "npm run build",
    "repro": "npm run build && node repro/smoke-fixes.mjs && node repro/trace-cancel.mjs"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@opencode/plugin": "^2.0.27"
  }
}
